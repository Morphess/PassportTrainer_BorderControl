<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ua.passporttrainer.controller.LearningBrowserController"
            styleClass="screen-root learning-browser">
    <padding>
        <Insets top="20.0" right="24.0" bottom="20.0" left="24.0" />
    </padding>
    <top>
        <VBox spacing="6.0">
            <Label fx:id="headingLabel" styleClass="screen-title" text="%learning.unavailableHeading" />
            <Label fx:id="documentTypeLabel" styleClass="section-title" />
            <Label fx:id="documentTitleLabel" styleClass="support-label learning-document-title" wrapText="true" />
            <Label fx:id="variantLabel" styleClass="support-label" wrapText="true" />
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
        </VBox>
    </top>
    <center>
        <StackPane fx:id="imagePane" minHeight="320.0" minWidth="320.0" styleClass="image-panel">
            <BorderPane.margin>
                <Insets top="16.0" bottom="16.0" />
            </BorderPane.margin>
            <ImageView fx:id="passportImageView" preserveRatio="true" smooth="true" />
            <ProgressIndicator fx:id="loadingIndicator" maxHeight="64.0" maxWidth="64.0" />
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="backButton" accessibleText="%learning.chooseAnotherAccessible"
                    onAction="#goBack" text="%learning.chooseAnother" />
            <Button fx:id="previousButton" accessibleText="%learning.previousAccessible"
                    onAction="#showPreviousDocument" text="%learning.previous" />
            <Label fx:id="documentCounterLabel" styleClass="support-label" />
            <Button fx:id="nextButton" accessibleText="%learning.nextAccessible"
                    onAction="#showNextDocument" text="%learning.next" />
        </HBox>
    </bottom>
</BorderPane>
